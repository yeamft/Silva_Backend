NODE_ENV=development
PORT=3000
TRUST_PROXY=false

DATABASE_URL=postgresql://coffee:coffee@localhost:5432/coffee_field_os?schema=public

JWT_SECRET=change-me-jwt-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN=604800

BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20

# Require authenticator OTP on login (default off for local/demo)
OTP_ON_LOGIN=false

# Frontend URL (invite/reset links) and CORS
APP_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080

MAIL_PROVIDER=smtp
MAIL_FROM=SPX Farm OS <noreply@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
