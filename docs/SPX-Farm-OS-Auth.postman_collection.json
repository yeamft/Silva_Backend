{
  "info": {
    "_postman_id": "spx-farm-os-auth-api",
    "name": "SPX Farm OS — Auth API",
    "description": "Auth scaffold endpoints for SPX Farm OS (`/api/v1/auth`).\n\nDemo users (after seed), password `Password123!`:\n- owner@silva.example\n- principal@spx.example\n- lead@bagro.example\n\nAfter **Login**, the collection scripts store `accessToken` and `refreshToken` for authenticated requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "programId", "value": "prg_shecha" },
    { "key": "sessionId", "value": "" },
    { "key": "otpChallengeToken", "value": "" },
    { "key": "enrollmentToken", "value": "" },
    { "key": "resetToken", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "API Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Config",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/config",
            "description": "Returns `{ otpOnLogin: boolean }`."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const data = json && json.data;",
                  "if (data && data.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', data.accessToken);",
                  "}",
                  "if (data && data.refreshToken) {",
                  "  pm.collectionVariables.set('refreshToken', data.refreshToken);",
                  "}",
                  "if (data && data.otpChallengeToken) {",
                  "  pm.collectionVariables.set('otpChallengeToken', data.otpChallengeToken);",
                  "}",
                  "if (data && data.enrollmentToken) {",
                  "  pm.collectionVariables.set('enrollmentToken', data.enrollmentToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner@silva.example\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Signup (disabled)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New User\",\n  \"email\": \"new@example.com\",\n  \"password\": \"Password123!\",\n  \"orgName\": \"Example Org\",\n  \"orgSlug\": \"example-org\",\n  \"orgType\": \"silva\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/signup",
            "description": "Always returns 403 SIGNUP_DISABLED."
          }
        },
        {
          "name": "Refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const data = json && json.data;",
                  "if (data && data.accessToken) pm.collectionVariables.set('accessToken', data.accessToken);",
                  "if (data && data.refreshToken) pm.collectionVariables.set('refreshToken', data.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/refresh"
          }
        },
        {
          "name": "Me",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/me"
          }
        },
        {
          "name": "Logout",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/logout"
          }
        }
      ]
    },
    {
      "name": "MFA",
      "item": [
        {
          "name": "Verify OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const data = json && json.data;",
                  "if (data && data.accessToken) pm.collectionVariables.set('accessToken', data.accessToken);",
                  "if (data && data.refreshToken) pm.collectionVariables.set('refreshToken', data.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otpChallengeToken\": \"{{otpChallengeToken}}\",\n  \"code\": \"123456\",\n  \"deviceLabel\": \"Postman\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/otp/verify"
          }
        },
        {
          "name": "Enroll TOTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const data = json && json.data;",
                  "if (data && data.accessToken) pm.collectionVariables.set('accessToken', data.accessToken);",
                  "if (data && data.refreshToken) pm.collectionVariables.set('refreshToken', data.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enrollmentToken\": \"{{enrollmentToken}}\",\n  \"code\": \"123456\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/totp/enroll"
          }
        }
      ]
    },
    {
      "name": "Password",
      "item": [
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner@silva.example\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/password/forgot"
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/password/reset"
          }
        },
        {
          "name": "Change Password",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"Password123!\",\n  \"newPassword\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/password/change"
          }
        }
      ]
    },
    {
      "name": "Program & Tenant",
      "item": [
        {
          "name": "Switch Program",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const data = json && json.data;",
                  "if (data && data.accessToken) pm.collectionVariables.set('accessToken', data.accessToken);",
                  "if (data && data.refreshToken) pm.collectionVariables.set('refreshToken', data.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"programId\": \"{{programId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/switch-program"
          }
        },
        {
          "name": "Update Tenant Branding",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Silva\",\n  \"branding\": {\n    \"primaryColor\": \"#1B4332\"\n  }\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/tenant/branding"
          }
        },
        {
          "name": "Complete Onboarding",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Silva\",\n  \"branding\": {\n    \"tagline\": \"Coffee estate OS\"\n  }\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/onboarding/complete"
          }
        }
      ]
    },
    {
      "name": "Sessions",
      "item": [
        {
          "name": "List Sessions",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const rows = json && json.data;",
                  "if (Array.isArray(rows) && rows[0] && rows[0].id) {",
                  "  pm.collectionVariables.set('sessionId', rows[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/sessions"
          }
        },
        {
          "name": "Revoke Session",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/sessions/{{sessionId}}"
          }
        }
      ]
    }
  ]
}
