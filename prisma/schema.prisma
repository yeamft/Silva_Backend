generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationType {
  silva
  spx
  vendor
}

enum TenantStatus {
  active
  suspended
  pending
}

enum ProgramStatus {
  active
  archived
}

enum ProgramMemberRole {
  owner
  manager
  executor
  viewer
}

enum UserAccountStatus {
  invited
  active
  suspended
}

model organizations {
  id           String           @id
  name         String
  slug         String           @unique
  displayName  String
  type         OrganizationType
  brandingJson Json?
  status       TenantStatus     @default(active)
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  users              users[]
  programsCreated    programs[]            @relation("ProgramCreator")
  programMemberships program_memberships[]
}

model programs {
  id             String        @id
  name           String
  slug           String        @unique
  status         ProgramStatus @default(active)
  brandingJson   Json?
  createdByOrgId String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  createdByOrg organizations         @relation("ProgramCreator", fields: [createdByOrgId], references: [id])
  memberships  program_memberships[]
  usersActive  users[]               @relation("ActiveProgram")
}

model program_memberships {
  id             String            @id
  programId      String
  organizationId String
  roleInProgram  ProgramMemberRole @default(manager)
  createdAt      DateTime          @default(now())

  program      programs      @relation(fields: [programId], references: [id], onDelete: Cascade)
  organization organizations @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([programId, organizationId])
  @@index([organizationId])
}

model users {
  id              String            @id
  name            String
  email           String            @unique
  passwordHash    String
  role            String
  organizationId  String
  activeProgramId String?
  active          Boolean           @default(true)
  accountStatus   UserAccountStatus @default(active)
  totpSecret      String?
  totpEnrolledAt  DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization    organizations      @relation(fields: [organizationId], references: [id])
  activeProgram   programs?          @relation("ActiveProgram", fields: [activeProgramId], references: [id])
  refreshSessions refresh_sessions[]

  @@index([organizationId])
  @@index([role])
  @@index([activeProgramId])
}

model refresh_sessions {
  id            String    @id
  userId        String
  tokenHash     String    @unique
  expiresAt     DateTime
  revoked       Boolean   @default(false)
  otpVerifiedAt DateTime?
  deviceLabel   String?
  lastActiveAt  DateTime?
  createdAt     DateTime  @default(now())
  user          users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revoked])
}

model password_reset_tokens {
  id        String   @id
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}
