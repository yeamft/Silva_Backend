  farm_blocks farm_blocks @relation(fields: [blockId], references: [id])
  users       users?      @relation(fields: [userId], references: [id])
  work_orders work_orders @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@unique([workOrderId, blockId])
  @@index([blockId])
}

model work_order_tasks {
  id                                            String      @id
  workOrderId                                   String
  title                                         String
  description                                   String      @default("")
