generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model organizations {
  id                                                                        String                     @id
  name                                                                      String
  slug                                                                      String                     @unique
  displayName                                                               String
  type                                                                      OrganizationType
  brandingJson                                                              Json?
  status                                                                    TenantStatus               @default(active)
  active                                                                    Boolean                    @default(true)
  createdAt                                                                 DateTime                   @default(now())
  updatedAt                                                                 DateTime                   @updatedAt
  isDefaultExecutionPartner                                                 Boolean                    @default(false)
  farm_estates                                                              farm_estates[]
  invites                                                                   invites[]
  message_threads_message_threads_counterpartyOrganizationIdToorganizations message_threads[]          @relation("message_threads_counterpartyOrganizationIdToorganizations")
  message_threads_message_threads_spxOrganizationIdToorganizations          message_threads[]          @relation("message_threads_spxOrganizationIdToorganizations")
  messages                                                                  messages[]
  organization_memberships                                                  organization_memberships[]
  programMemberships                                                        program_memberships[]
  program_org_invites_program_org_invites_fromOrganizationIdToorganizations program_org_invites[]      @relation("program_org_invites_fromOrganizationIdToorganizations")
  program_org_invites_program_org_invites_toOrganizationIdToorganizations   program_org_invites[]      @relation("program_org_invites_toOrganizationIdToorganizations")
  programsCreated                                                           programs[]                 @relation("ProgramCreator")
  registration_requests                                                     registration_requests[]
  users                                                                     users[]
  vendors                                                                   vendors?
  asset_owners                                                              asset_owners[]
}

model programs {
  id                            String                      @id
  name                          String
  slug                          String                      @unique
  status                        ProgramStatus               @default(active)
  brandingJson                  Json?
  createdByOrgId                String
  createdAt                     DateTime                    @default(now())
  updatedAt                     DateTime                    @updatedAt
  cropfortAfeBandAMaxEtb        Decimal                     @default(500000) @db.Decimal(14, 2)
  cropfortAfeBandBMaxEtb        Decimal                     @default(2000000) @db.Decimal(14, 2)
  cropfortAfeBandCMaxEtb        Decimal                     @default(5000000) @db.Decimal(14, 2)
  cropfortCurrency              String                      @default("ETB")
  cropfortHectareContractTotal  Decimal?                    @db.Decimal(10, 2)
  cropfortOpexEnforcement       OpexReserveEnforcement      @default(informational)
  cropfortOpexReserveBalanceEtb Decimal?                    @db.Decimal(14, 2)
  cropfortOpexReserveMinMonths  Decimal                     @default(6) @db.Decimal(5, 2)
  cropfortPartialWeeklyRelease  Boolean                     @default(false)
  cropfortRateFlagThresholdPct  Decimal                     @default(10) @db.Decimal(5, 2)
  cropfortVarianceReviewPct     Decimal                     @default(20) @db.Decimal(5, 2)
  accountability_matrix         accountability_matrix[]
  activity_catalog              activity_catalog[]
  activity_master               activity_master[]
  activity_requests             activity_requests[]
  activity_schedule             activity_schedule[]
  afes                          afes[]
  afp_block_lines               afp_block_lines[]
  afp_line_schedules            afp_line_schedules[]
  afp_lines                     afp_lines[]
  afp_plan_intensities          afp_plan_intensities[]
  audit_log                     audit_log[]
  benchmark_surveys             benchmark_surveys[]
  block_field_tickets           block_field_tickets[]
  core_operation_projects       core_operation_projects[]
  cropfort_activity_plans       cropfort_activity_plans[]
  cropfort_afes                 cropfort_afes[]
  cropfort_elections            cropfort_elections[]
  cropfort_programme_plans      cropfort_programme_plans[]
  cropfort_weekly_plans         cropfort_weekly_plans[]
  cropfort_monthly_work_orders  cropfort_monthly_work_orders[]
  cropfort_daily_field_records  cropfort_daily_field_records[]
  cropfort_direct_instructions  cropfort_direct_instructions[]
  cropfort_projects             cropfort_projects[]
  cropfort_interventions        cropfort_interventions[]
  cropfort_plan_scenarios       cropfort_plan_scenarios[]
  cropfort_user_roles           cropfort_user_roles[]
  farm_blocks                   farm_blocks[]
  farm_estates                  farm_estates[]
  fee_schedules                 fee_schedules[]
  field_tickets                 field_tickets[]
  gl_journal_exports            gl_journal_exports[]
  harvest_kpi_snapshots         harvest_kpi_snapshots[]
  ifs_forms                     ifs_forms[]
  item_comments                 item_comments[]
  labor_rate_cards              labor_rate_cards[]
  material_rate_cards           material_rate_cards[]
  service_rate_cards            service_rate_cards[]
  message_threads               message_threads[]
  monthly_client_reports        monthly_client_reports[]
  notifications                 notifications[]
  owner_settlements             owner_settlements[]
  payment_requests              payment_requests[]
  platform_config               platform_config?
  memberships                   program_memberships[]
  program_org_invites           program_org_invites[]
  createdByOrg                  organizations               @relation("ProgramCreator", fields: [createdByOrgId], references: [id])
  rateCardCategories            rate_card_categories[]
  rateCardLines                 rate_card_lines[]
  rate_card_proposals           rate_card_proposals[]
  related_party_disclosures     related_party_disclosures[]
  reports                       reports[]
  schedule3_thresholds          schedule3_thresholds[]
  schedule4_insurance           schedule4_insurance[]
  season_calendars              season_calendars[]
  season_windows                season_windows[]
  spx_revenue_ledger            spx_revenue_ledger[]
  supervisor_progress           supervisor_progress[]
  usersActive                   users[]                     @relation("ActiveProgram")
  weekly_submissions            weekly_submissions[]
  work_orders                   work_orders[]
  work_plan_submissions         work_plan_submissions[]
}

model program_memberships {
  id             String            @id
  programId      String
  organizationId String
  roleInProgram  ProgramMemberRole @default(manager)
  createdAt      DateTime          @default(now())
  organization   organizations     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  program        programs          @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, organizationId])
  @@index([organizationId])
}

model users {
  id                                                                   String                         @id
  name                                                                 String
  email                                                                String                         @unique
  passwordHash                                                         String
  role                                                                 String
  organizationId                                                       String
  activeProgramId                                                      String?
  active                                                               Boolean                        @default(true)
  accountStatus                                                        UserAccountStatus              @default(active)
  totpSecret                                                           String?
  totpEnrolledAt                                                       DateTime?
  createdAt                                                            DateTime                       @default(now())
  updatedAt                                                            DateTime                       @updatedAt
  vendorId                                                             String?
  activity_requests                                                    activity_requests[]
  afes                                                                 afes[]
  afp_block_lines                                                      afp_block_lines[]
  afp_lines                                                            afp_lines[]
  attachments                                                          attachments[]
  audit_log                                                            audit_log[]
  benchmark_surveys_benchmark_surveys_approverUserIdTousers            benchmark_surveys[]            @relation("benchmark_surveys_approverUserIdTousers")
  benchmark_surveys_benchmark_surveys_createdByUserIdTousers           benchmark_surveys[]            @relation("benchmark_surveys_createdByUserIdTousers")
  block_field_tickets                                                  block_field_tickets[]
  cropfort_afes                                                        cropfort_afes[]
  cropfort_elections                                                   cropfort_elections[]
  cropfort_programme_plans_created                                     cropfort_programme_plans[]     @relation("programme_plans_createdBy")
  cropfort_programme_plans_submitted                                   cropfort_programme_plans[]     @relation("programme_plans_submittedBy")
  cropfort_programme_plans_reviewed                                    cropfort_programme_plans[]     @relation("programme_plans_reviewedBy")
  cropfort_weekly_plans_created                                        cropfort_weekly_plans[]        @relation("weekly_plans_createdBy")
  cropfort_monthly_work_orders_created                                 cropfort_monthly_work_orders[] @relation("monthly_wo_createdBy")
  cropfort_daily_field_records_created                                 cropfort_daily_field_records[] @relation("dfr_createdBy")
  cropfort_direct_instructions_created                                 cropfort_direct_instructions[] @relation("di_createdBy")
  cropfort_projects_created                                            cropfort_projects[]             @relation("cropfort_projects_createdBy")
  cropfort_interventions_created                                       cropfort_interventions[]        @relation("cropfort_interventions_createdBy")
  cropfort_plan_scenarios_created                                      cropfort_plan_scenarios[]       @relation("cropfort_plan_scenarios_createdBy")
  cropfort_user_roles                                                  cropfort_user_roles[]
  farm_blocks                                                          farm_blocks[]
  farm_estates_farm_estates_approverUserIdTousers                      farm_estates[]                 @relation("farm_estates_approverUserIdTousers")
  farm_estates_farm_estates_fieldManagerUserIdTousers                  farm_estates[]                 @relation("farm_estates_fieldManagerUserIdTousers")
  farm_workflow_stages                                                 farm_workflow_stages[]
  fee_schedules                                                        fee_schedules[]
  field_tickets_field_tickets_signedOffByUserIdTousers                 field_tickets[]                @relation("field_tickets_signedOffByUserIdTousers")
  field_tickets_field_tickets_submittedByUserIdTousers                 field_tickets[]                @relation("field_tickets_submittedByUserIdTousers")
  ifs_forms_ifs_forms_submittedByUserIdTousers                         ifs_forms[]                    @relation("ifs_forms_submittedByUserIdTousers")
  ifs_forms_ifs_forms_validatedByUserIdTousers                         ifs_forms[]                    @relation("ifs_forms_validatedByUserIdTousers")
  invites                                                              invites[]
  item_comments                                                        item_comments[]
  labor_rate_cards                                                     labor_rate_cards[]
  message_thread_reads                                                 message_thread_reads[]
  message_threads                                                      message_threads[]
  messages                                                             messages[]
  monthly_client_reports                                               monthly_client_reports[]
  notifications                                                        notifications[]
  organization_memberships                                             organization_memberships[]
  owner_settlements                                                    owner_settlements[]
  payment_requests_payment_requests_requestedByUserIdTousers           payment_requests[]             @relation("payment_requests_requestedByUserIdTousers")
  payment_requests_payment_requests_spxVerifiedByUserIdTousers         payment_requests[]             @relation("payment_requests_spxVerifiedByUserIdTousers")
  rate_card_lines                                                      rate_card_lines[]
  rate_card_proposals_rate_card_proposals_approvedByUserIdTousers      rate_card_proposals[]          @relation("rate_card_proposals_approvedByUserIdTousers")
  rate_card_proposals_rate_card_proposals_createdByUserIdTousers       rate_card_proposals[]          @relation("rate_card_proposals_createdByUserIdTousers")
  refreshSessions                                                      refresh_sessions[]
  registration_requests                                                registration_requests[]
  reports_reports_createdByUserIdTousers                               reports[]                       @relation("reports_createdBy")
  reports_reports_releasedByUserIdTousers                              reports[]                       @relation("reports_releasedBy")
  season_calendars                                                     season_calendars[]
  supervisor_progress                                                  supervisor_progress[]
  activeProgram                                                        programs?                      @relation("ActiveProgram", fields: [activeProgramId], references: [id])
  organization                                                         organizations                  @relation(fields: [organizationId], references: [id])
  vendors                                                              vendors?                       @relation(fields: [vendorId], references: [id])
  vendor_scorecards                                                    vendor_scorecards[]
  work_order_assignments                                               work_order_assignments[]
  work_order_block_assignments                                         work_order_block_assignments[]
  work_order_tasks_work_order_tasks_assigneeUserIdTousers              work_order_tasks[]             @relation("work_order_tasks_assigneeUserIdTousers")
  work_order_tasks_work_order_tasks_createdByUserIdTousers             work_order_tasks[]             @relation("work_order_tasks_createdByUserIdTousers")
  work_plan_submissions_work_plan_submissions_reviewedByUserIdTousers  work_plan_submissions[]        @relation("work_plan_submissions_reviewedByUserIdTousers")
  work_plan_submissions_work_plan_submissions_submittedByUserIdTousers work_plan_submissions[]        @relation("work_plan_submissions_submittedByUserIdTousers")

  @@index([organizationId])
  @@index([role])
  @@index([activeProgramId])
}

model refresh_sessions {
  id            String    @id
  userId        String
  tokenHash     String    @unique
  expiresAt     DateTime
  revoked       Boolean   @default(false)
  otpVerifiedAt DateTime?
  deviceLabel   String?
  lastActiveAt  DateTime?
  createdAt     DateTime  @default(now())
  user          users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revoked])
}

model password_reset_tokens {
  id        String   @id
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model rate_card_categories {
  id        String   @id
  programId String
  value     String
  label     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  program   programs @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, value])
  @@index([programId])
}

model rate_card_lines {
  id                    String             @id
  programId             String
  farmEstateId          String?
  resourceCode          String
  resourceName          String
  resourceType          String?
  unitOfMeasure         String
  rateEtb               Decimal            @db.Decimal(14, 4)
  benchmarkFarmARate    Decimal?           @db.Decimal(14, 4)
  benchmarkFarmBRate    Decimal?           @db.Decimal(14, 4)
  spxJustificationNote  String?
  status                CropfortLineStatus @default(draft)
  /** Fiscal year start (e.g. 2026 = FY 2026/27, Jul–Jun). */
  budgetYear            Int
  archivedAt            DateTime?
  version               Int                @default(1)
  supersedesId          String?
  effectiveFrom         DateTime?
  effectiveTo           DateTime?
  submittedAt           DateTime?
  approvedAt            DateTime?
  returnedComment       String?
  createdByUserId       String
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  users                 users              @relation(fields: [createdByUserId], references: [id])
  farm_estates          farm_estates?      @relation(fields: [farmEstateId], references: [id], onDelete: Cascade)
  program               programs           @relation(fields: [programId], references: [id])
  rate_card_lines       rate_card_lines?   @relation("rate_card_linesTorate_card_lines", fields: [supersedesId], references: [id])
  other_rate_card_lines rate_card_lines[]  @relation("rate_card_linesTorate_card_lines")

  @@index([programId, status])
  @@index([farmEstateId, status])
  @@index([programId, resourceCode])
  @@index([programId, budgetYear])
  @@index([programId, archivedAt])
}

model accountability_matrix {
  programId           String
  operatingDiscipline String
  executeRole         String
  validateRole        String
  decideRole          String
  authorRole          String
  schedule3Ref        String
  programs            programs @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@id([programId, operatingDiscipline])
}

model activity_catalog {
  id                String              @id
  programId         String
  afpLineId         String
  sectionCode       String
  sectionLabel      String
  sortOrder         Int
  nameEn            String
  nameAm            String?
  unit              String
  normMdPerUnit     Decimal?            @db.Decimal(10, 6)
  normCostEtb       Decimal?            @db.Decimal(14, 4)
  normWageEtb       Decimal?            @db.Decimal(10, 2)
  normsPerMd        Decimal?            @db.Decimal(10, 2)
  annualQuantity    Decimal?            @db.Decimal(14, 2)
  annualMandays     Decimal?            @db.Decimal(14, 2)
  annualCostEtb     Decimal?            @db.Decimal(14, 2)
  scopeJson         Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  afp_lines         afp_lines           @relation(fields: [afpLineId], references: [id])
  programs          programs            @relation(fields: [programId], references: [id])
  activity_requests activity_requests[]
  activity_schedule activity_schedule[]
  field_tickets     field_tickets[]
  work_orders       work_orders[]

  @@index([programId, afpLineId])
  @@index([programId, sectionCode])
}

model activity_master {
  id                      String                    @id
  programId               String
  templateId              String?
  code                    String
  name                    String
  laborNorm               Decimal?                  @db.Decimal(14, 6)
  materialNorm            Decimal?                  @db.Decimal(14, 6)
  serviceNorm             Decimal?                  @db.Decimal(14, 6)
  laborWageEtb            Decimal?                  @db.Decimal(14, 2)
  laborCostPerUnit        Decimal?                  @db.Decimal(14, 4)
  materialRateCode        String?
  serviceRateCode         String?
  benchmarkFarmARate      Decimal?                  @db.Decimal(14, 4)
  benchmarkFarmBRate      Decimal?                  @db.Decimal(14, 4)
  version                 Int                       @default(1)
  effectiveFrom           DateTime?
  effectiveTo             DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  programs                programs                  @relation(fields: [programId], references: [id])
  activity_templates      activity_templates?       @relation(fields: [templateId], references: [id])
  afp_block_lines         afp_block_lines[]
  afp_plan_intensities    afp_plan_intensities[]
  block_field_tickets     block_field_tickets[]
  cropfort_activity_plans cropfort_activity_plans[]
  cropfort_elections      cropfort_elections[]

  @@unique([programId, code, version])
  @@index([programId])
}

/// Platform-owned Cropfort activity taxonomy (Tier 1/2/3). Not farm- or program-scoped.
model activities {
  id                  String               @id
  tier                Int
  category            String
  name                String
  unitOfMeasure       String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  benchmark_surveys              benchmark_surveys[]
  labor_rate_cards               labor_rate_cards[]
  material_rate_cards            material_rate_cards[]
  service_rate_cards             service_rate_cards[]
  rate_card_proposals            rate_card_proposals[]
  cropfort_programme_plan_lines  cropfort_programme_plan_lines[]

  @@index([tier])
  @@index([category])
  @@index([tier, category])
}

model activity_requests {
  id                      String                   @id
  programId               String
  farmEstateId            String?
  requestType             ActivityRequestType
  operationKind           CoreOperationKind        @default(intervention)
  title                   String
  description             String?
  urgency                 ActivityRequestUrgency   @default(normal)
  blocksOrAreas           String?
  blockCode               String?
  blockIds                String[]                 @default([])
  activityIds             String[]                 @default([])
  plannedStartDate        DateTime?                @db.Date
  plannedEndDate          DateTime?                @db.Date
  estimatedAmountEtb      Decimal?                 @db.Decimal(14, 2)
  status                  ActivityRequestStatus    @default(submitted)
  origin                  ActivityRequestOrigin
  requestedByUserId       String
  vendorId                String?
  activityCatalogId       String?
  workPlanSubmissionId    String?
  suggestedAfpLineId      String?
  convertedAfeId          String?
  convertedCropfortAfeId  String?                  @unique
  dismissalReason         String?
  convertedAt             DateTime?
  dismissedAt             DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime
  activity_catalog        activity_catalog?        @relation(fields: [activityCatalogId], references: [id])
  cropfort_afes           cropfort_afes?           @relation(fields: [convertedCropfortAfeId], references: [id])
  farm_estates            farm_estates?            @relation(fields: [farmEstateId], references: [id])
  programs                programs                 @relation(fields: [programId], references: [id])
  users                   users                    @relation(fields: [requestedByUserId], references: [id])
  afp_lines               afp_lines?               @relation(fields: [suggestedAfpLineId], references: [id])
  vendors                 vendors?                 @relation(fields: [vendorId], references: [id])
  work_plan_submissions   work_plan_submissions?   @relation(fields: [workPlanSubmissionId], references: [id])
  afes                    afes?
  core_operation_projects core_operation_projects?

  @@index([origin, status])
  @@index([programId, operationKind, status])
  @@index([programId, status])
  @@index([requestedByUserId])
  @@index([vendorId])
}

model activity_schedule {
  id                String           @id
  activityCatalogId String
  programId         String
  year              Int
  month             Int
  plannedQuantity   Decimal?         @db.Decimal(14, 2)
  plannedMandays    Decimal?         @db.Decimal(14, 2)
  plannedCostEtb    Decimal?         @db.Decimal(14, 2)
  activity_catalog  activity_catalog @relation(fields: [activityCatalogId], references: [id], onDelete: Cascade)
  programs          programs         @relation(fields: [programId], references: [id])

  @@unique([activityCatalogId, year, month])
  @@index([programId, year, month])
}

model activity_templates {
  id               String            @id
  code             String            @unique
  name             String
  category         String
  tier             String            @default("standard")
  unitOfMeasure    String
  laborNorm        Decimal?          @db.Decimal(14, 6)
  materialNorm     Decimal?          @db.Decimal(14, 6)
  serviceNorm      Decimal?          @db.Decimal(14, 6)
  laborWageEtb     Decimal?          @db.Decimal(14, 2)
  laborCostPerUnit Decimal?          @db.Decimal(14, 4)
  materialRateCode String?
  serviceRateCode  String?
  createdAt        DateTime          @default(now())
  activity_master  activity_master[]
}

model afes {
  id                    String             @id
  programId             String
  afpLineId             String?
  afpBlockLineId        String?
  operatingDiscipline   String
  description           String
  estimatedCostUsd      Decimal            @db.Decimal(14, 2)
  band                  AfeBand
  planningMode          AfePlanningMode    @default(planned)
  origin                AfeOrigin          @default(spx_initiated)
  activityRequestId     String?            @unique
  spxValidated          Boolean            @default(false)
  silvaApprovalRequired Boolean
  silvaApproved         Boolean?
  approvalDate          DateTime?
  status                AfeStatus          @default(draft)
  createdByUserId       String
  createdAt             DateTime           @default(now())
  updatedAt             DateTime
  activity_requests     activity_requests? @relation(fields: [activityRequestId], references: [id])
  afp_block_lines       afp_block_lines?   @relation(fields: [afpBlockLineId], references: [id])
  afp_lines             afp_lines?         @relation(fields: [afpLineId], references: [id])
  users                 users              @relation(fields: [createdByUserId], references: [id])
  programs              programs           @relation(fields: [programId], references: [id])
  vendor_contracts      vendor_contracts[]
  work_orders           work_orders[]

  @@index([afpBlockLineId])
  @@index([planningMode, origin])
  @@index([programId, planningMode])
  @@index([programId, status, band])
}

model afp_block_lines {
  id                    String                 @id
  programId             String
  planYear              Int
  blockId               String
  activityId            String
  electionStatus        CropfortElectionStatus @default(suggested)
  sequence              Int                    @default(0)
  plannedStart          DateTime?
  plannedEnd            DateTime?
  plannedQty            Decimal                @db.Decimal(14, 4)
  status                CropfortLineStatus     @default(draft)
  version               Int                    @default(1)
  supersedesId          String?
  returnedComment       String?
  submittedAt           DateTime?
  approvedAt            DateTime?
  createdByUserId       String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime
  afes                  afes[]
  activity_master       activity_master        @relation(fields: [activityId], references: [id])
  farm_blocks           farm_blocks            @relation(fields: [blockId], references: [id])
  users                 users                  @relation(fields: [createdByUserId], references: [id])
  programs              programs               @relation(fields: [programId], references: [id])
  afp_block_lines       afp_block_lines?       @relation("afp_block_linesToafp_block_lines", fields: [supersedesId], references: [id])
  other_afp_block_lines afp_block_lines[]      @relation("afp_block_linesToafp_block_lines")

  @@index([programId, planYear, blockId])
  @@index([programId, status])
}

model afp_line_schedules {
  id             String    @id
  programId      String
  afpLineId      String
  year           Int
  month          Int
  plannedCostEtb Decimal   @db.Decimal(14, 2)
  plannedCostUsd Decimal?  @db.Decimal(14, 2)
  afp_lines      afp_lines @relation(fields: [afpLineId], references: [id], onDelete: Cascade)
  programs       programs  @relation(fields: [programId], references: [id])

  @@unique([afpLineId, year, month])
  @@index([programId, year, month])
}

model afp_lines {
  id                    String                 @id
  programId             String
  year                  Int
  operatingDiscipline   String
  activity              String
  budgetAllocatedUsd    Decimal                @db.Decimal(14, 2)
  budgetAllocatedEtb    Decimal?               @db.Decimal(14, 2)
  kpiTarget             String
  status                AfpStatus              @default(draft)
  silvaApproved         Boolean                @default(false)
  approvalDate          DateTime?
  notes                 String?
  workPlanSubmissionId  String?
  createdByUserId       String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime
  activity_catalog      activity_catalog[]
  activity_requests     activity_requests[]
  afes                  afes[]
