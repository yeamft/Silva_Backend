generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationType {
  silva
  spx
  vendor
}

enum TenantStatus {
  active
  suspended
  pending
}

enum RegistrationRequestStatus {
  submitted
  under_review
  approved
  rejected
}

enum ContactSubmissionStatus {
  new
  read
}

enum ProgramStatus {
  active
  archived
}

enum ProgramMemberRole {
  owner
  manager
  executor
  viewer
}

enum AfeBand {
  A
  B
  C
  D
}

enum AfpStatus {
  draft
  submitted
  approved
  active
  closed
}

enum AfeStatus {
  draft
  submitted
  validated
  approved
  active
  closed
  rejected
}

enum WorkOrderStatus {
  draft
  issued
  in_progress
  complete
  closed
}

enum WorkOrderTier {
  retainer
  project
  special
}

enum TaskStatus {
  draft
  open
  in_progress
  complete
  cancelled
}

enum FieldTicketStatus {
  draft
  submitted
  vendor_reviewed
  validated
  rejected
}

enum FieldTicketType {
  field_execution
  payroll_confirmation
}

enum WorkPlanSubmissionStatus {
  draft
  submitted
  revision_requested
  accepted
  rejected
}

enum ActivityRequestOrigin {
  silva_request
  vendor_request
}

enum ActivityRequestStatus {
  submitted
  converted
  dismissed
}

enum ActivityRequestType {
  coffee_testing
  farm_status_assessment
  soil_analysis
  quality_audit
  infrastructure_inspection
  urgent_field_work
  other
}

enum ActivityRequestUrgency {
  normal
  high
  urgent
}

enum AfeOrigin {
  spx_initiated
  silva_request
  vendor_request
}

enum AfePlanningMode {
  planned
  ad_hoc
}

enum FarmEstateStatus {
  active
  inactive
}

enum IfsFormType {
  daily_work_log
  pruning_completion
  fertilizer_application
  pest_disease_scout
  harvest_cherry_intake
  safety_stop_work
  equipment_downtime
  weather_field_readiness
  labor_attendance
  block_inspection
}

enum IfsFormStatus {
  draft
  submitted
  validated
  rejected
}

enum SeasonCalendarStatus {
  draft
  active
  archived
}

enum SeasonWindowStatus {
  planned
  issued
  in_progress
  complete
  cancelled
}

enum PaymentRequestStatus {
  draft
  submitted
  verified
  rejected
  settled
}

enum PaymentRequestType {
  bagro_fee
  reimbursable_cost
  vendor_fee
}

enum SettlementStatus {
  draft
  authorized
  settled
}

enum SettlementType {
  bagro_fee
  labor_wages
  vendor_payment
}

enum VendorStatus {
  active
  pending
  expired
  terminated
}

enum ProcurementRoute {
  sole_source
  competitive_tender
}

enum TenderStatus {
  n_a
  in_progress
  awarded
}

enum RevenueTier {
  retainer
  project
  special
}

enum InvoicePaymentStatus {
  invoiced
  paid
  overdue
}

enum ReportType {
  weekly
  monthly
  quarterly
  annual
}

enum ReportStatus {
  draft
  in_review
  released
}

enum InviteStatus {
  pending
  accepted
  revoked
  expired
}

enum GlExportStatus {
  pending
  ready
  failed
}

enum MessageCounterpartyType {
  vendor
  asset_owner
}

enum CropfortRole {
  field_supervisor
  field_manager
  bagro_office
  spx_validator
  farm_owner
  farm_owner_viewer
  spx_platform_admin
}

enum FarmBlockStatus {
  active
  inactive
}

enum FarmWorkflowStageKey {
  farm_block_setup
  benchmark_survey
  rate_cards_confirmed
  fee_schedule_set
  tier_election
  activity_plan
  master_plan_calendar
  supervisor_progress
  budgets_cash_flow
  monthly_client_report
}

enum SupervisorPctComplete {
  pct_0
  pct_25
  pct_50
  pct_75
  pct_100
}

enum MonthlyReportStatus {
  draft
  ready
  sent
}

enum CropfortLineStatus {
  draft
  submitted
  approved
  returned
}

enum FieldWorkIntensity {
  peak
  active
  light
}

enum FieldWorkCommercialStatus {
  confirmed
  elective
  quoted
}

enum CropfortElectionStatus {
  suggested
  elected
}

enum BlockFieldTicketStatus {
  draft
  submitted
  reviewed_approved
  reviewed_flagged
  reviewed_returned
  released
}

enum WeeklySubmissionStatus {
  pending
  submitted
  validated
  released
}

enum ValidationCheckType {
  rate_card_compliance
  election_compliance
  afp_sequencing
  variance_review
  afe_band_check
  materials_estimate
}

enum ValidationCheckResult {
  pass
  fail
  flag
  resolved
}

enum CropfortAfeSourceType {
  afp_line
  weekly_submission
  intervention
  project
  manual
}

enum CoreOperationKind {
  intervention
  project
}

enum CoreOperationProjectStatus {
  active
  complete
  closed
}

enum OpexReserveEnforcement {
  informational
  blocking
}

enum UserAccountStatus {
  invited
  active
  suspended
}

enum MessageThreadStatus {
  open
  archived
}

model organizations {
  id                        String           @id
  name                      String
  slug                      String           @unique
  displayName               String
  type                      OrganizationType
  brandingJson              Json?
  status                    TenantStatus     @default(active)
  isDefaultExecutionPartner Boolean          @default(false)
  active                    Boolean          @default(true)
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  users                     users[]
  memberships               organization_memberships[]
  invites                   invites[]
  vendor                    vendors?
  programsCreated           programs[]       @relation("ProgramCreator")
  programMemberships        program_memberships[]
  programInvitesSent        program_org_invites[] @relation("ProgramInviteFrom")
  programInvitesReceived    program_org_invites[] @relation("ProgramInviteTo")
  registrationRequests      registration_requests[]
  ownedFarmEstates          farm_estates[]        @relation("FarmEstateOwner")
  messageThreadsAsSpx       message_threads[]     @relation("MessageThreadSpxOrg")
  messageThreadsAsCounterparty message_threads[]  @relation("MessageThreadCounterpartyOrg")
  messagesSent              messages[]            @relation("MessageSenderOrg")
}

model registration_requests {
  id                  String                    @id
  orgType             OrganizationType
  status              RegistrationRequestStatus @default(submitted)
  orgName             String
  orgSlug             String
  displayName         String?
  legalName           String?
  country             String?
  region              String?
  address             String?
  website             String?
  contactName         String
  contactEmail        String
  contactPhone        String?
  contactTitle        String?
  assetInterests      String?
  estimatedHectares   Decimal?                  @db.Decimal(12, 2)
  governanceNotes     String?
  vendorCategory      String?
  servicesProvided    String?
  insuranceOnFile     Boolean?
  fieldCapacity       String?
  profileJson         Json?
  reviewNotes         String?
  reviewedByUserId    String?
  reviewedAt          DateTime?
  provisionedOrgId    String?
  activationTokenHash String?
  activationExpiresAt DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  reviewedBy          users?                    @relation("RegistrationReviewer", fields: [reviewedByUserId], references: [id])
  provisionedOrg      organizations?            @relation(fields: [provisionedOrgId], references: [id])

  @@index([status])
  @@index([contactEmail])
  @@index([orgSlug])
}

model contact_submissions {
  id           String                  @id
  name         String
  email        String
  organization String?
  subject      String
  message      String
  status       ContactSubmissionStatus @default(new)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([status])
  @@index([email])
  @@index([createdAt])
}

model programs {
  id              String        @id
  name            String
  slug            String        @unique
  status          ProgramStatus @default(active)
  brandingJson    Json?
  createdByOrgId  String
  cropfortCurrency             String                 @default("ETB")
  cropfortAfeBandAMaxEtb       Decimal                @default(500000) @db.Decimal(14, 2)
  cropfortAfeBandBMaxEtb       Decimal                @default(2000000) @db.Decimal(14, 2)
  cropfortAfeBandCMaxEtb       Decimal                @default(5000000) @db.Decimal(14, 2)
  cropfortRateFlagThresholdPct Decimal                @default(10) @db.Decimal(5, 2)
  cropfortVarianceReviewPct    Decimal                @default(20) @db.Decimal(5, 2)
  cropfortOpexReserveMinMonths Decimal                @default(6) @db.Decimal(5, 2)
  cropfortOpexEnforcement      OpexReserveEnforcement @default(informational)
  cropfortHectareContractTotal Decimal?               @db.Decimal(10, 2)
  cropfortOpexReserveBalanceEtb Decimal?              @db.Decimal(14, 2)
  cropfortPartialWeeklyRelease Boolean                @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  createdByOrg    organizations @relation("ProgramCreator", fields: [createdByOrgId], references: [id])
  memberships     program_memberships[]
  orgInvites      program_org_invites[]
  usersActive     users[]       @relation("ActiveProgram")

  afpLines        afp_lines[]
  afes            afes[]
  workOrders      work_orders[]
  fieldTickets    field_tickets[]
  paymentRequests payment_requests[]
  settlements     owner_settlements[]
  revenueLedger   spx_revenue_ledger[]
  reports         reports[]
  notifications   notifications[]
  harvestKpis     harvest_kpi_snapshots[]
  auditLogs       audit_log[]
  ifsForms        ifs_forms[]
  seasonCalendars season_calendars[]
  seasonWindows   season_windows[]
  schedule3       schedule3_thresholds[]
  schedule4       schedule4_insurance[]
  accountability  accountability_matrix[]
  platformConfig  platform_config?
  disclosures     related_party_disclosures[]
  glExports       gl_journal_exports[]
  itemComments    item_comments[]
  activityCatalog activity_catalog[]
  activitySchedules activity_schedule[]
  afpLineSchedules afp_line_schedules[]
  workPlanSubmissions work_plan_submissions[]
  farmBlocks      farm_blocks[]
  farmEstates     farm_estates[]
  messageThreads  message_threads[]
  activityRequests activity_requests[]
  cropfortRoles         cropfort_user_roles[]
  rateCardLines         rate_card_lines[]
  activityMaster        activity_master[]
  afpBlockLines         afp_block_lines[]
  blockFieldTickets     block_field_tickets[]
  weeklySubmissions     weekly_submissions[]
  cropfortAfes          cropfort_afes[]
  coreOperationProjects core_operation_projects[]
  benchmarkSurveys      benchmark_surveys[]
  laborRateCards        labor_rate_cards[]
  cropfortElections     cropfort_elections[]
  cropfortActivityPlans cropfort_activity_plans[]
  feeSchedules          fee_schedules[]
  fieldWorkCalendars    field_work_calendars[]
  supervisorProgress    supervisor_progress[]
  monthlyClientReports  monthly_client_reports[]
}

model program_memberships {
  id             String            @id
  programId      String
  organizationId String
  roleInProgram  ProgramMemberRole @default(manager)
  createdAt      DateTime          @default(now())

  program        programs          @relation(fields: [programId], references: [id], onDelete: Cascade)
  organization   organizations     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([programId, organizationId])
  @@index([organizationId])
}

model program_org_invites {
  id                String       @id
  programId         String
  fromOrganizationId String
  toOrganizationId  String?
  toOrgSlug         String?
  toEmail           String?
  roleInProgram     ProgramMemberRole @default(executor)
  status            InviteStatus @default(pending)
  tokenHash         String       @unique
  expiresAt         DateTime
  createdAt         DateTime     @default(now())

  program           programs     @relation(fields: [programId], references: [id], onDelete: Cascade)
  fromOrganization  organizations @relation("ProgramInviteFrom", fields: [fromOrganizationId], references: [id])
  toOrganization    organizations? @relation("ProgramInviteTo", fields: [toOrganizationId], references: [id])
}

model users {
  id               String   @id
  name             String
  email            String   @unique
  passwordHash     String
  role             String
  organizationId   String
  vendorId         String?
  activeProgramId  String?
  active           Boolean  @default(true)
  accountStatus    UserAccountStatus @default(active)
  totpSecret       String?
  totpEnrolledAt   DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization     organizations @relation(fields: [organizationId], references: [id])
  vendor           vendors?      @relation(fields: [vendorId], references: [id])
  activeProgram    programs?     @relation("ActiveProgram", fields: [activeProgramId], references: [id])
  memberships      organization_memberships[]
  invitesSent      invites[]     @relation("InvitedBy")
  registrationReviews registration_requests[] @relation("RegistrationReviewer")
  refreshSessions  refresh_sessions[]
  notifications    notifications[]
  auditLogs        audit_log[]
  attachments      attachments[]
  assignedWos      work_order_assignments[]
  tasksAssigned    work_order_tasks[] @relation("TaskAssignee")
  tasksCreated     work_order_tasks[] @relation("TaskCreator")
  fieldTickets     field_tickets[]    @relation("TicketSubmitter")
  ticketsSigned    field_tickets[]    @relation("TicketSigner")
  paymentRequests  payment_requests[] @relation("PrRequester")
  prsVerified      payment_requests[] @relation("PrVerifier")
  settlementsAuth  owner_settlements[] @relation("SettlementAuthorizer")
  scorecards       vendor_scorecards[]
  reportsReleased  reports[]
  afpCreated       afp_lines[]
  afeCreated       afes[]
  ifsSubmitted     ifs_forms[] @relation("IfsSubmitter")
  ifsValidated     ifs_forms[] @relation("IfsValidator")
  itemComments     item_comments[]
  seasonCalendars  season_calendars[]
  workPlansSubmitted work_plan_submissions[] @relation("WorkPlanSubmitter")
  workPlansReviewed  work_plan_submissions[] @relation("WorkPlanReviewer")
  blockAssignments   work_order_block_assignments[] @relation("BlockManager")
  messageThreadsCreated message_threads[] @relation("MessageThreadCreator")
  messagesSent          messages[]        @relation("MessageSender")
  messageThreadReads    message_thread_reads[]
  activityRequests      activity_requests[]
  cropfortRoles         cropfort_user_roles[]
  supervisedBlocks      farm_blocks[]           @relation("BlockSupervisor")
  rateCardLinesCreated  rate_card_lines[]       @relation("RateCardCreator")
  afpBlockLinesCreated  afp_block_lines[]       @relation("AfpBlockCreator")
  blockFieldTickets     block_field_tickets[]   @relation("BlockTicketSubmitter")
  cropfortAfesCreated   cropfort_afes[]         @relation("CropfortAfeCreator")
  farmsAsApprover       farm_estates[]          @relation("FarmApprover")
  farmsAsFieldManager   farm_estates[]          @relation("FarmFieldManager")
  workflowStagesCompleted farm_workflow_stages[] @relation("WorkflowStageCompleter")
  benchmarkSurveysCreated benchmark_surveys[]   @relation("BenchmarkSurveyCreator")
  benchmarkSurveysApproved benchmark_surveys[]  @relation("BenchmarkSurveyApprover")
  laborRateCardsCreated labor_rate_cards[]      @relation("LaborRateCardCreator")
  cropfortElectionsCreated cropfort_elections[] @relation("CropfortElectionCreator")
  feeSchedulesCreated   fee_schedules[]         @relation("FeeScheduleCreator")
  fieldWorkCalendarsCreated field_work_calendars[] @relation("FieldWorkCalendarCreator")
  monthlyReportsCreated monthly_client_reports[] @relation("MonthlyReportCreator")
  supervisorProgressUpdates supervisor_progress[] @relation("SupervisorProgressUpdater")

  @@index([organizationId])
  @@index([role])
  @@index([activeProgramId])
}

model organization_memberships {
  id             String   @id
  userId         String
  organizationId String
  role           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  user           users         @relation(fields: [userId], references: [id])
  organization   organizations @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId])
}

model invites {
  id              String       @id
  organizationId  String
  vendorId        String?
  email           String
  role            String
  status          InviteStatus @default(pending)
  tokenHash       String
  invitedByUserId String
  expiresAt       DateTime
  createdAt       DateTime     @default(now())

  organization    organizations @relation(fields: [organizationId], references: [id])
  invitedBy       users         @relation("InvitedBy", fields: [invitedByUserId], references: [id])
}

model refresh_sessions {
  id            String    @id
  userId        String
  tokenHash     String    @unique
  expiresAt     DateTime
  revoked       Boolean   @default(false)
  otpVerifiedAt DateTime?
  deviceLabel   String?
  lastActiveAt  DateTime?
  createdAt     DateTime  @default(now())
  user          users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revoked])
}

model password_reset_tokens {
  id        String   @id
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model restricted_export_credentials {
  id        String    @id
  name      String
  tokenHash String    @unique
  active    Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}

model vendors {
  id                        String       @id
  organizationId            String       @unique
  name                      String
  category                  String
  servicesProvided          String       @default("")
  prequalified              Boolean      @default(false)
  insuranceOnFile           Boolean      @default(false)
  insuranceExpiry           DateTime?
  status                    VendorStatus @default(pending)
  isDefaultExecutionPartner Boolean      @default(false)
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  organization              organizations @relation(fields: [organizationId], references: [id])
  users                     users[]
  workOrders                work_orders[]
  contracts                 vendor_contracts[]
  scorecards                vendor_scorecards[]
  workPlanSubmissions       work_plan_submissions[]
  farmEstateVendors         farm_estate_vendors[]
  activityRequests          activity_requests[]
}

model afp_lines {
  id                    String    @id
  programId             String
  year                  Int
  operatingDiscipline   String
  activity              String
  budgetAllocatedUsd    Decimal   @db.Decimal(14, 2)
  budgetAllocatedEtb    Decimal?  @db.Decimal(14, 2)
  kpiTarget             String
  status                AfpStatus @default(draft)
  silvaApproved         Boolean   @default(false)
  approvalDate          DateTime?
  notes                 String?
  workPlanSubmissionId  String?
  createdByUserId       String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  program               programs  @relation(fields: [programId], references: [id])
  createdBy             users     @relation(fields: [createdByUserId], references: [id])
  workPlanSubmission    work_plan_submissions? @relation(fields: [workPlanSubmissionId], references: [id])
  afes                  afes[]
  activityCatalog       activity_catalog[]
  lineSchedules         afp_line_schedules[]
  activityRequests      activity_requests[]

  @@index([programId, year, status])
  @@index([workPlanSubmissionId])
}

model afes {
  id                    String          @id
  programId             String
  afpLineId             String?
  afpBlockLineId        String?
  operatingDiscipline   String
  description           String
  estimatedCostUsd      Decimal         @db.Decimal(14, 2)
  band                  AfeBand
  planningMode          AfePlanningMode @default(planned)
  origin                AfeOrigin       @default(spx_initiated)
  activityRequestId     String?         @unique
  spxValidated          Boolean         @default(false)
  silvaApprovalRequired Boolean
  silvaApproved         Boolean?
  approvalDate          DateTime?
  status                AfeStatus       @default(draft)
  createdByUserId       String
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  program               programs            @relation(fields: [programId], references: [id])
  afp                   afp_lines?          @relation(fields: [afpLineId], references: [id])
  afpBlockLine          afp_block_lines?    @relation(fields: [afpBlockLineId], references: [id])
  createdBy             users               @relation(fields: [createdByUserId], references: [id])
  activityRequest       activity_requests?  @relation(fields: [activityRequestId], references: [id])
  workOrders            work_orders[]
  contracts             vendor_contracts[]

  @@index([programId, status, band])
  @@index([planningMode, origin])
  @@index([programId, planningMode])
  @@index([afpBlockLineId])
}

model work_orders {
  id                  String          @id
  programId           String
  afeId               String
  category            String
  activity            String
  tier                WorkOrderTier
  weekStart           Int
  weekEnd             Int
  spxOversightHoursL1 Int             @default(0)
  spxOversightHoursL2 Int             @default(0)
  spxOversightHoursL3 Int             @default(0)
  assignedVendorId    String?
  activityCatalogId   String?
  status              WorkOrderStatus @default(draft)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  program             programs        @relation(fields: [programId], references: [id])
  afe                 afes            @relation(fields: [afeId], references: [id])
  assignedVendor      vendors?        @relation(fields: [assignedVendorId], references: [id])
  activityCatalog     activity_catalog? @relation(fields: [activityCatalogId], references: [id])
  assignments         work_order_assignments[]
  blockAssignments    work_order_block_assignments[]
  tasks               work_order_tasks[]
  fieldTickets        field_tickets[]
  paymentRequests     payment_requests[]
  settlements         owner_settlements[]
  ifsForms            ifs_forms[]
  seasonWindows       season_windows[]

  @@index([programId, status])
  @@index([activityCatalogId])
}

model work_order_assignments {
  id          String       @id
  workOrderId String
  userId      String
  roleOnOrder String
  isPrimary   Boolean      @default(false)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  workOrder   work_orders  @relation(fields: [workOrderId], references: [id])
  user        users        @relation(fields: [userId], references: [id])
}

model work_order_tasks {
  id              String      @id
  workOrderId     String
  title           String
  description     String      @default("")
  assigneeUserId  String?
  status          TaskStatus  @default(open)
  dueDate         DateTime?
  createdByUserId String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  workOrder       work_orders @relation(fields: [workOrderId], references: [id])
  assignee        users?      @relation("TaskAssignee", fields: [assigneeUserId], references: [id])
  createdBy       users       @relation("TaskCreator", fields: [createdByUserId], references: [id])
}

model field_tickets {
  id                 String            @id
  programId          String
  workOrderId        String
  submittedByUserId  String
  activityCatalogId  String?
  ticketType         FieldTicketType   @default(field_execution)
  activityRecorded   String
  areaHa             Decimal           @db.Decimal(10, 2)
  laborCount         Int
  materialsUsed      String            @default("")
  actualQuantity     Decimal?          @db.Decimal(14, 2)
  actualMandays      Decimal?          @db.Decimal(14, 2)
  actualCostEtb      Decimal?          @db.Decimal(14, 2)
  normValidationJson Json?
  ticketDate         DateTime
  signedOff          Boolean           @default(false)
  signedOffByUserId  String?
  signedOffAt        DateTime?
  status             FieldTicketStatus @default(draft)
  paymentRequestId   String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  program            programs          @relation(fields: [programId], references: [id])
  workOrder          work_orders       @relation(fields: [workOrderId], references: [id])
  activityCatalog    activity_catalog? @relation(fields: [activityCatalogId], references: [id])
  submittedBy        users             @relation("TicketSubmitter", fields: [submittedByUserId], references: [id])
  signedOffBy        users?            @relation("TicketSigner", fields: [signedOffByUserId], references: [id])
  paymentRequests    payment_requests[]
  ifsForms           ifs_forms[]

  @@index([programId, status])
  @@index([activityCatalogId])
}

model payment_requests {
  id                  String               @id
  programId           String
  workOrderId         String
  fieldTicketId       String
  requestedByUserId   String
  type                PaymentRequestType
  amountRequestedEtb  Decimal              @db.Decimal(14, 2)
  dateSubmitted       DateTime?
  spxVerified         Boolean              @default(false)
  spxVerifiedByUserId String?
  verifiedDate        DateTime?
  status              PaymentRequestStatus @default(draft)
  settlementId        String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  program             programs             @relation(fields: [programId], references: [id])
  workOrder           work_orders          @relation(fields: [workOrderId], references: [id])
  fieldTicket         field_tickets        @relation(fields: [fieldTicketId], references: [id])
