model season_calendars {
  id              String               @id
  programId       String
  year            Int
  name            String
  status          SeasonCalendarStatus @default(draft)
  notes           String?
  createdByUserId String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime
  users           users                @relation(fields: [createdByUserId], references: [id])
  programs        programs             @relation(fields: [programId], references: [id])
  season_windows  season_windows[]

  @@unique([programId, year, name])
  @@index([programId, year, status])
}

model season_windows {
  id                  String             @id
  calendarId          String
  programId           String
  operatingDiscipline String
  activity            String
  weekStart           Int
  weekEnd             Int
  status              SeasonWindowStatus @default(planned)
  linkedWorkOrderId   String?
  notes               String?
  issuedAt            DateTime?
  completedAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime
  season_calendars    season_calendars   @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  work_orders         work_orders?       @relation(fields: [linkedWorkOrderId], references: [id])
  programs            programs           @relation(fields: [programId], references: [id])

  @@index([calendarId, weekStart])
  @@index([programId, status])
}

model spx_revenue_ledger {
  id             String               @id
  programId      String
  period         String
  tier           RevenueTier
  feeDescription String
  amountEtb      Decimal              @db.Decimal(14, 2)
  amountUsd      Decimal              @db.Decimal(14, 2)
  invoiceDate    DateTime
  paymentStatus  InvoicePaymentStatus @default(invoiced)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime
  programs       programs             @relation(fields: [programId], references: [id])

  @@index([programId, period])
}

model spx_validation_checks {
  id                 String                @id
  programId          String
  weeklySubmissionId String
  checkType          ValidationCheckType
  result             ValidationCheckResult
  isHardBlock        Boolean
  note               String?
  resolvedAt         DateTime?
  createdAt          DateTime              @default(now())
  weekly_submissions weekly_submissions    @relation(fields: [weeklySubmissionId], references: [id], onDelete: Cascade)

  @@index([weeklySubmissionId])
}

model supervisor_progress {
  id                      String                  @id
  programId               String
  activityPlanId          String                  @unique
  pctComplete             SupervisorPctComplete   @default(pct_0)
  lastMovementDate        DateTime?               @db.Date
  updatedByUserId         String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime
  cropfort_activity_plans cropfort_activity_plans @relation(fields: [activityPlanId], references: [id], onDelete: Cascade)
  programs                programs                @relation(fields: [programId], references: [id])
  users                   users?                  @relation(fields: [updatedByUserId], references: [id])

  @@index([programId])
}

model vendor_contracts {
  id               String           @id
  vendorId         String
  afeId            String
  contractValueUsd Decimal          @db.Decimal(14, 2)
  procurementRoute ProcurementRoute
  tenderStatus     TenderStatus     @default(n_a)
  contractStart    DateTime
  contractEnd      DateTime
  afes             afes             @relation(fields: [afeId], references: [id])
  vendors          vendors          @relation(fields: [vendorId], references: [id])
}

model vendor_scorecards {
  id                 String   @id
  vendorId           String
  reviewPeriod       String
  qualityScore       Int
  timelinessScore    Int
  costAdherenceScore Int
  overallScore       Int
  reviewedByUserId   String
  notes              String?
  createdAt          DateTime @default(now())
  users              users    @relation(fields: [reviewedByUserId], references: [id])
  vendors            vendors  @relation(fields: [vendorId], references: [id])

  @@unique([vendorId, reviewPeriod])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model vendors {
  id                        String                  @id
  organizationId            String                  @unique
  name                      String
  category                  String
  servicesProvided          String                  @default("")
  prequalified              Boolean                 @default(false)
  insuranceOnFile           Boolean                 @default(false)
  insuranceExpiry           DateTime?
  status                    VendorStatus            @default(pending)
  isDefaultExecutionPartner Boolean                 @default(false)
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime
  activity_requests         activity_requests[]
  farm_estate_vendors       farm_estate_vendors[]
  users                     users[]
  vendor_contracts          vendor_contracts[]
  vendor_scorecards         vendor_scorecards[]
  organizations             organizations           @relation(fields: [organizationId], references: [id])
  work_orders               work_orders[]
  work_plan_submissions     work_plan_submissions[]
}

model weekly_submission_tickets {
  id                  String              @id
  weeklySubmissionId  String
  blockFieldTicketId  String
  block_field_tickets block_field_tickets @relation(fields: [blockFieldTicketId], references: [id], onDelete: Cascade)
  weekly_submissions  weekly_submissions  @relation(fields: [weeklySubmissionId], references: [id], onDelete: Cascade)

  @@unique([weeklySubmissionId, blockFieldTicketId])
}

model weekly_submissions {
  id                        String                      @id
  programId                 String
  weekEnding                DateTime                    @db.Date
  status                    WeeklySubmissionStatus      @default(pending)
  submittedAt               DateTime?
  releasedAt                DateTime?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime
  spx_validation_checks     spx_validation_checks[]
  weekly_submission_tickets weekly_submission_tickets[]
  programs                  programs                    @relation(fields: [programId], references: [id])

  @@unique([programId, weekEnding])
  @@index([programId, status])
}

model work_order_assignments {
  id          String      @id
