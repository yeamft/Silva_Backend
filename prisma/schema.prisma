  users_work_order_tasks_createdByUserIdTousers users       @relation("work_order_tasks_createdByUserIdTousers", fields: [createdByUserId], references: [id])
  work_orders                                   work_orders @relation(fields: [workOrderId], references: [id])
}

model work_orders {
  id                           String                         @id
  programId                    String
  afeId                        String?
  cropfortAfeId                String?
  code                         String?
  title                        String?
  category                     String
  activity                     String
  tier                         WorkOrderTier                  @default(retainer)
  weekStart                    Int
  weekEnd                      Int
  plannedCostEtb               Decimal?                       @db.Decimal(14, 2)
  farmEstateId                 String?
  instructions                 String?
  spxOversightHoursL1          Int                            @default(0)
  spxOversightHoursL2          Int                            @default(0)
  spxOversightHoursL3          Int                            @default(0)
  assignedVendorId             String?
  activityCatalogId            String?
  status                       WorkOrderStatus                @default(draft)
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime
  field_tickets                field_tickets[]
  ifs_forms                    ifs_forms[]
  owner_settlements            owner_settlements[]
  payment_requests             payment_requests[]
  season_windows               season_windows[]
  work_order_assignments       work_order_assignments[]
  work_order_block_assignments work_order_block_assignments[]
  work_order_tasks             work_order_tasks[]
  activity_catalog             activity_catalog?              @relation(fields: [activityCatalogId], references: [id])
  afes                         afes?                          @relation(fields: [afeId], references: [id])
  cropfort_afes                cropfort_afes?                 @relation(fields: [cropfortAfeId], references: [id])
  farm_estates                 farm_estates?                  @relation(fields: [farmEstateId], references: [id])
  vendors                      vendors?                       @relation(fields: [assignedVendorId], references: [id])
  programs                     programs                       @relation(fields: [programId], references: [id])

  @@index([activityCatalogId])
  @@index([programId, status])
  @@index([afeId])
  @@index([cropfortAfeId])
  @@index([assignedVendorId])
  @@index([farmEstateId])
  @@unique([programId, code])
}

model work_plan_submissions {
  id                                                   String                   @id
  programId                                            String
  vendorId                                             String
  farmEstateId                                         String?
  farmName                                             String?
  totalAreaHa                                          Decimal?                 @db.Decimal(10, 2)
  budgetYearLabel                                      String
  budgetYearGc                                         Int
  status                                               WorkPlanSubmissionStatus @default(draft)
  fxEtbPerUsd                                          Decimal                  @db.Decimal(10, 2)
  parsedJson                                           Json?
  sourceAttachmentId                                   String?
  submittedAt                                          DateTime?
  submittedByUserId                                    String?
  reviewedAt                                           DateTime?
  reviewedByUserId                                     String?
  reviewNotes                                          String?
  promotedAt                                           DateTime?
  createdAt                                            DateTime                 @default(now())
  updatedAt                                            DateTime
  activity_requests                                    activity_requests[]
  afp_lines                                            afp_lines[]
  farm_estates                                         farm_estates?            @relation(fields: [farmEstateId], references: [id])
  programs                                             programs                 @relation(fields: [programId], references: [id])
  users_work_plan_submissions_reviewedByUserIdTousers  users?                   @relation("work_plan_submissions_reviewedByUserIdTousers", fields: [reviewedByUserId], references: [id])
  users_work_plan_submissions_submittedByUserIdTousers users?                   @relation("work_plan_submissions_submittedByUserIdTousers", fields: [submittedByUserId], references: [id])
  vendors                                              vendors                  @relation(fields: [vendorId], references: [id])

  @@index([farmEstateId])
  @@index([programId, status])
  @@index([vendorId, budgetYearGc])
}

